# Le jeton __ALERT_WEBHOOK_TOKEN__ est remplacé au démarrage du conteneur.
route:
  receiver: finflow
  group_by: ["alertname"]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h

receivers:
  - name: finflow
    webhook_configs:
      - url: http://backend:8000/api/v1/alert-webhook/
        send_resolved: true
        http_config:
          authorization:
            type: Bearer
            credentials: __ALERT_WEBHOOK_TOKEN__
