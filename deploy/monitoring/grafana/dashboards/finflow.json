{
  "uid": "finflow-ops",
  "title": "FIN_FLOW — exploitation",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Base",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "finflow_health_database", "refId": "A" }],
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "KO" }, "1": { "text": "OK" } } }] } }
    },
    {
      "type": "stat",
      "title": "Cache",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "finflow_health_cache", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "File Celery",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "finflow_celery_queue_length", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "CBS en échec (15 min)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "finflow_cbs_failed_recent", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Latence HTTP p95",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum by (le) (rate(finflow_http_request_duration_seconds_bucket[5m])))",
        "refId": "A",
        "legendFormat": "p95"
      }]
    },
    {
      "type": "timeseries",
      "title": "Requêtes par statut",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{
        "expr": "sum by (status) (rate(finflow_http_requests_total[5m]))",
        "refId": "A",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "type": "logs",
      "title": "Journaux backend et workers",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "expr": "{container=~\".*(backend|worker|beat).*\"}",
        "refId": "A"
      }]
    }
  ]
}
