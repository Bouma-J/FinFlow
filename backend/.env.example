# =========================================================================
# FIN_FLOW - Exemple de configuration d'environnement
# Copier ce fichier en `.env` et adapter les valeurs.
# =========================================================================

# Environnement de settings à charger : config.settings.dev | config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev

# Sécurité
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
# En dev, si DATABASE_URL est absent, un SQLite local est utilisé automatiquement.
# En production, utiliser PostgreSQL, par exemple :
# DATABASE_URL=postgres://finflow:finflow@localhost:5432/finflow
DATABASE_URL=

# CORS (frontend)
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# Stockage documentaire (GED) compatible S3 (MinIO ou équivalent)
# STORAGE_BACKEND=local | s3
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=finflow-documents
AWS_S3_ENDPOINT_URL=http://localhost:9000
# Domaine public (navigateur) — en Docker Compose : localhost:9000
AWS_S3_CUSTOM_DOMAIN=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ADDRESSING_STYLE=path
AWS_S3_URL_PROTOCOL=http:
AWS_QUERYSTRING_AUTH=True

# Pooling connexions Postgres (secondes). Avec PgBouncer transaction : 0.
DB_CONN_MAX_AGE=60

# Rétention piste d'audit (jours). 0 = pas de purge automatique.
AUDIT_RETENTION_DAYS=365

# Fraîcheur max des snapshots reporting (secondes)
REPORTING_SNAPSHOT_MAX_AGE_SECONDS=3600

# Isolation : shared (défaut) | schema (cible réglementaire — voir docs/)
TENANT_ISOLATION_MODE=shared

# Sentry (optionnel)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Celery / Redis (traitements asynchrones : notifications, connecteurs CBS, batchs)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# =========================================================================
# E-mail — alertes workflow
# =========================================================================
# Mode console (dev / Docker démo) : les mails s'affichent dans les logs.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
FRONTEND_BASE_URL=http://localhost

# -------------------------------------------------------------------------
# Exemple Gmail (SMTP)
# -------------------------------------------------------------------------
# 1. Compte Google → Sécurité → Validation en 2 étapes : ACTIVÉE
# 2. Sécurité → Mots de passe des applications → générer un mot de passe
#    pour « Mail » (16 caractères, sans espaces)
# 3. Remplacer les valeurs ci-dessous et décommenter ce bloc
#    (commentez alors le EMAIL_BACKEND console ci-dessus)
#
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=votre.compte@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# DEFAULT_FROM_EMAIL=FIN_FLOW <votre.compte@gmail.com>
# Si Avast/Norton injecte un certificat auto-signé (CERTIFICATE_VERIFY_FAILED) :
# SMTP_SSL_VERIFY=0
# En production : SMTP_SSL_VERIFY=1 (défaut Django)
# FRONTEND_BASE_URL=http://localhost
#
# Notes :
# - Le mot de passe ci-dessus est un « App Password », PAS le mot de passe
#   habituel du compte Google.
# - DEFAULT_FROM_EMAIL doit utiliser la même adresse que EMAIL_HOST_USER
#   (Gmail refuse souvent d'émettre sous un autre expéditeur).
# - En Docker : recopier ces variables dans le fichier `.env` à la racine
#   du projet (à côté de docker-compose.yml) puis :
#   docker compose up -d --force-recreate backend worker beat

# Devise de consolidation Groupe (reporting multi-devises)
GROUP_CONSOLIDATION_CURRENCY=XOF
