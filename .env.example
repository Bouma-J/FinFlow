# =========================================================================
# FIN_FLOW — variables d'environnement (racine du projet)
# Utilisé par docker compose. Ne pas committer de secrets réels.
# Guide Ubuntu : documentation/13-guide-deploiement-ubuntu.md
# =========================================================================

# --- Démo locale (optionnel) ---
# SEED_DEMO=0
# DJANGO_SECRET_KEY=change-me-in-production

# --- Production Ubuntu (docker-compose.prod.yml) ---
# DJANGO_SECRET_KEY=
# DJANGO_ALLOWED_HOSTS=finflow.votredomaine.tld,localhost,127.0.0.1,backend
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_SECURE_HSTS_PRELOAD=True
# # Accès par IP : 604800 (Let's Encrypt) ou 0 (auto-signé) ; INCLUDE_SUBDOMAINS/PRELOAD=False
# DJANGO_CORS_ALLOWED_ORIGINS=https://finflow.votredomaine.tld
# FRONTEND_BASE_URL=https://finflow.votredomaine.tld
# FINFLOW_PUBLIC_IP=
# POSTGRES_PASSWORD=
# REDIS_PASSWORD=
# MINIO_ROOT_USER=
# MINIO_ROOT_PASSWORD=
# AWS_S3_CUSTOM_DOMAIN=minio.votredomaine.tld
# AWS_S3_URL_PROTOCOL=https:
# SMTP_SSL_VERIFY=1
# FIELD_ENCRYPTION_KEY=   # openssl rand -base64 32 | tr '+/' '-_'
# ENABLE_API_DOCS=0       # Swagger /schema en prod (défaut off)

# --- Exemple Gmail (décommenter et remplir) ---
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=votre.compte@gmail.com
# EMAIL_HOST_PASSWORD=xxxxxxxxxxxxxxxx
# DEFAULT_FROM_EMAIL=FIN_FLOW <votre.compte@gmail.com>
# FRONTEND_BASE_URL=http://localhost
