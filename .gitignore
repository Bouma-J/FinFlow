# Certificats CA locaux (proxy à inspection TLS) — spécifiques au poste.
# Les dossiers backend/certs et frontend/certs restent versionnés (.gitkeep)
# pour que Docker COPY certs/ fonctionne hors proxy d'entreprise.
**/certs/*
!**/certs/.gitkeep
**/certs/ca-bundle.crt

# Frontend (Node / Vite)
node_modules/
/frontend/dist/
/frontend/.vite/
npm-debug.log*

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Fichiers temporaires Office
CONTRATS/~$*
**/~$*


docker-rebuild.log
*.log

